{
  "name": "bookmark-organizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 书签智能分类扩展（零构建：原生 ES Module）",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:falsify": "python tests/product_falsification.py",
    "test:falsify:llm": "python tests/falsify_inject_path.py",
    "test:e2e": "node --test tests/e2e/run.js",
    "test:repro": "node tests/e2e/repro-organize.js",
    "test:real": "node tests/e2e/repro-real.js",
    "test:revert": "node tests/e2e/revert-guard.js",
    "test:stale": "node tests/e2e/stale-ids.js",
    "test:matrix": "node tests/e2e/matrix.js",
    "test:llm": "node tests/e2e/llm-path.js",
    "test:scale": "node tests/e2e/scale.js 800",
    "log:sink": "python tools/fail_log_sink.py",
    "log:sink:selftest": "python tools/fail_log_sink.py --selftest",
    "test:all": "python tools/verify_all.py",
    "package": "python tools/package.py"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
