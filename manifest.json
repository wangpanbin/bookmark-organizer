{
  "name": "书签整理助手",
  "version": "1.0.0",
  "description": "按功能智能分类 Chrome 书签：规则基线 + LLM 兜底，支持 dry-run 预览、幂等重跑、自动备份与回滚。",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "favicon"
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:8731/*",
    "http://127.0.0.1:8732/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "ui/icons/icon-16.png",
    "32": "ui/icons/icon-32.png",
    "48": "ui/icons/icon-48.png",
    "128": "ui/icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "ui/icons/icon-16.png",
      "32": "ui/icons/icon-32.png",
      "48": "ui/icons/icon-48.png",
      "128": "ui/icons/icon-128.png"
    },
    "default_popup": "ui/popup.html",
    "default_title": "书签整理助手"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
