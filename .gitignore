# 依赖（Playwright 只在跑 E2E 时需要，不入库）
node_modules/

# 注入的 API key（tools/inject_key.py 生成）
# 绝不能进版本库，也绝不能进发布 zip
src/llm-key.local.js

# 测试输出（TAP 日志、诊断报告，每次跑都会变）
tests/.*
!tests/.gitignore

# 证伪脚本的临时备份
*.bak
*.bak.*

# 打包产物
dist/
*.zip

# MATT 工作流的草稿：spec.md 与 issues/*.md 是「还在讨论的东西」，
# 不是交付物。入库会让 README 之外的读者误以为这是既定设计，
# 也会让 git 历史里堆满改到一半的决策。定稿后再写进 docs/。
.scratch/

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地 AI 编码工具（ZCode）的同步防护文件，内容与本文件重复，
# 属于个人工具配置，不该进版本库
.zcodeignore
