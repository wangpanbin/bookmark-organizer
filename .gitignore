# 依赖（Playwright 只在跑 E2E 时需要，不入库）
node_modules/

# 注入的 API key（tools/inject_key.py 生成）
# 绝不能进版本库，也绝不能进发布 zip
src/llm-key.local.js

# 测试输出（TAP 日志、诊断报告，每次跑都会变）
tests/.*
!tests/.gitignore

# 证伪脚本的临时备份
*.bak
*.bak.*

# 打包产物
dist/
*.zip

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地 AI 编码工具（ZCode）的同步防护文件，内容与本文件重复，
# 属于个人工具配置，不该进版本库
.zcodeignore
